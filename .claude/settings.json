{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git commit *)",
            "command": "\"${CLAUDE_PROJECT_DIR}/.claude/hooks/check-eval-before-commit.sh\"",
            "shell": "bash",
            "timeout": 300
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git commit *)",
            "command": "\"${CLAUDE_PROJECT_DIR}/.claude/hooks/post-commit-push-reminder.sh\"",
            "shell": "bash",
            "timeout": 15
          }
        ]
      }
    ]
  }
}